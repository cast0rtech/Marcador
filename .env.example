# Configuración de Base de Datos PostgreSQL
POSTGRES_DB=bms_db
POSTGRES_USER=bms_user
POSTGRES_PASSWORD=bms_password

# Configuración Industrial (BACnet / Modbus)
# Define la IP y máscara local del host/Raspberry Pi para BACnet (ej. 192.168.1.50/24)
BACNET_IP=192.168.1.10/24

# Configuración del Servidor SMTP para Notificaciones
SMTP_HOSTNAME=smtp.tudominio.com
SMTP_PORT=587
SMTP_USERNAME=usuario_smtp
SMTP_PASSWORD=password_smtp
SMTP_STARTTLS=true
SMTP_SENDER=alertas-bms@empresa-industrial.com
BMS_FALLBACK_EMAIL=centro-control-bms@empresa.com

# Configuración SIP / PBX para Llamadas de Voz (VoIP)
SIP_SERVER=192.168.1.100
SIP_PORT=5060
SIP_USER=101
SIP_PASS=password_sip
SIP_OPERATOR_PHONE=+41791234567
DEFAULT_NOTIFICATION_CHANNEL=email # Opciones: email, voice

